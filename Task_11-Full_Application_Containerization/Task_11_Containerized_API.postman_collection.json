									"let recs = JSON.parse(pm.collectionVariables.get('test_records') || '[]');",
									"let res = pm.response.json();",
									"let lbl = res.predictions ? res.predictions[0].predicted_label : 'N/A';",
									"let conf = res.predictions ? (res.predictions[0].confidence_score * 100).toFixed(1) + '%' : 'N/A';",
									"recs.push({",
									"    test: 'TC-03: Single Prediction - Low Risk',",
									"    endpoint: 'POST /predict',",
									"    status: pm.response.code === 200 && lbl === 'Low Risk' ? 'PASS' : 'FAIL',",
									"    status_code: pm.response.code,",
									"    rtt: pm.response.responseTime + ' ms',",
									"    details: 'Predicted: ' + lbl + ' (Conf: ' + conf + ')'",
