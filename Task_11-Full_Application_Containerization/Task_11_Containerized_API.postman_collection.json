									"    .subtitle { font-size: 13px; color: #64748b; margin-top: 4px; }",
									"    .metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 24px; }",
									"    .metric-card { background: #f1f5f9; padding: 14px; border-radius: 8px; text-align: center; border-left: 4px solid #3b82f6; }",
									"    .metric-val { font-size: 26px; font-weight: 700; color: #1e3a8a; }",
									"    .metric-lbl { font-size: 11px; font-weight: 600; text-transform: uppercase; color: #64748b; margin-top: 4px; }",
									"    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }",
									"    th { background: #1e3a8a; color: white; text-align: left; padding: 10px 12px; font-size: 12px; text-transform: uppercase; }",
									"    td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; }",
									"    tr:nth-child(even) { background: #f8fafc; }",
									"    .badge { display: inline-block; padding: 3px 8px; border-radius: 12px; font-weight: 700; font-size: 11px; }",
