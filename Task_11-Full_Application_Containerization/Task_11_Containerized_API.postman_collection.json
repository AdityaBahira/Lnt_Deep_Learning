									"});",
									"pm.test(\"Container Backend is healthy & Model Loaded\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(\"healthy\");",
									"    pm.expect(jsonData.model_loaded).to.be.true;",
									"});",
									"",
									"// Append to cumulative records",
									"let recs = [];",
									"try { recs = JSON.parse(pm.collectionVariables.get('test_records') || '[]'); } catch(e) { recs = []; }",
									"recs.push({",
									"    test: 'TC-01: Flask Backend Health Probe',",
									"    endpoint: 'GET /health',",
									"    status: pm.response.code === 200 ? 'PASS' : 'FAIL',",
									"    status_code: pm.response.code,",
									"    rtt: pm.response.responseTime + ' ms',",
									"    details: 'Model: DeepHealthRiskNet, Device: CPU'",
									"});",
									"pm.collectionVariables.set('test_records', JSON.stringify(recs));"
								],
								"type": "text/javascript"
							}
						}
					],
