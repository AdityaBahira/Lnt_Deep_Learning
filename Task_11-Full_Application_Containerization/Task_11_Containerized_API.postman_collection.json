									"let records = [];",
									"try {",
									"    records = JSON.parse(pm.collectionVariables.get('test_records') || '[]');",
									"} catch(e) { records = []; }",
									"",
									"let total = records.length;",
									"let passed = records.filter(r => r.status === 'PASS').length;",
									"let failed = total - passed;",
									"let passRate = total > 0 ? ((passed / total) * 100).toFixed(1) : '100.0';",
									"",
									"pm.test(\"All accumulated test cases passed\", function () {",
									"    pm.expect(failed).to.eql(0);",
									"});",
