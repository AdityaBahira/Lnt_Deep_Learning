									"      </div>",
									"      <div class='metric-card' style='border-left-color: #8b5cf6;'>",
									"        <div class='metric-val' style='color: #6d28d9;'>${passRate}%</div>",
									"        <div class='metric-lbl'>Success Rate</div>",
									"      </div>",
									"    </div>",
									"    <table>",
